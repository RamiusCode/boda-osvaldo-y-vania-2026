---
// src/components/CodigoVestimenta.astro
// "Código de Vestimenta" en Great Vibes con el adorno de rombo debajo, la
// etiqueta en Cinzel y la pareja vestida de gala (codigo.png).
//
// Entrada: el título se escribe como a mano, la etiqueta aparece y la
// pareja sube con un fundido.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Código de Vestimenta";
const etiqueta = "Etiqueta Formal";
// ──────────────────────────────────────────────────────────────
---

<section id="codigo-vestimenta" class="seccion">
    <p class="titulo titulo-principal font-great-vibes">{titulo}</p>

    <!-- Adorno: dos filetes que salen de un rombo -->
    <div class="adorno" aria-hidden="true">
        <i class="adorno-linea adorno-izq"></i>
        <i class="adorno-rombo"></i>
        <i class="adorno-linea adorno-der"></i>
    </div>

    <p class="etiqueta">{etiqueta}</p>

    <img
        src="/imagenes/codigo.png"
        alt="Pareja vestida de gala: ella con vestido largo, él de traje"
        width="579"
        height="991"
        class="pareja"
    />
</section>

<style>
    .seccion {
        /* Las letras se miden contra el ancho de la sección */
        container-type: inline-size;
        position: relative;
        width: 100%;
        padding: 8cqw 6cqw 10cqw;
        text-align: center;
    }

    .titulo {
        margin: 0;
        /* Aire para los rulos: la entrada lo recorta de izquierda a derecha */
        padding: 0 4cqw;
        display: inline-block;
        color: #9a7433;
        font-size: 13cqw;
        line-height: 1.15;
    }

    /* ── Adorno debajo del título ──────────────────────────────── */
    .adorno {
        margin: 1.6cqw auto 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.4cqw;
    }

    .adorno-linea {
        display: block;
        width: 18cqw;
        height: 1px;
    }

    .adorno-izq {
        background-image: linear-gradient(
            90deg,
            rgba(176, 141, 87, 0) 0%,
            #b08d57 100%
        );
        transform-origin: 100% 50%;
    }

    .adorno-der {
        background-image: linear-gradient(
            90deg,
            #b08d57 0%,
            rgba(176, 141, 87, 0) 100%
        );
        transform-origin: 0% 50%;
    }

    .adorno-rombo {
        display: block;
        width: 1.9cqw;
        height: 1.9cqw;
        border: 1px solid #b08d57;
        transform: rotate(45deg);
    }

    .etiqueta {
        margin: 3cqw 0 0;
        font-family: "Cinzel", serif;
        font-size: 5cqw;
        letter-spacing: 0.03em;
        color: #6e5a52;
    }

    .pareja {
        display: block;
        width: 30cqw;
        height: auto;
        margin: 6cqw auto 0;
        user-select: none;
        -webkit-user-drag: none;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("codigo-vestimenta");
        if (!seccion) return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const pareja = seccion.querySelector(".pareja");

        // Los títulos se escriben; los márgenes negativos dejan pasar los rulos
        const tapado = "inset(-40% 100% -40% 0%)";
        const escrito = "inset(-40% 0% -40% 0%)";

        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: seccion,
                start: "top 80%",
                toggleActions: "play none none reset",
            },
        });

        tl.fromTo(
            seccion.querySelector(".titulo-principal"),
            { clipPath: tapado },
            { clipPath: escrito, duration: 1.3, ease: "power1.inOut" },
        )
            .fromTo(
                seccion.querySelector(".adorno-rombo"),
                { opacity: 0, scale: 0, rotate: -45 },
                {
                    opacity: 1,
                    scale: 1,
                    rotate: 45,
                    duration: 0.6,
                    ease: "back.out(2)",
                },
                0.8,
            )
            .fromTo(
                seccion.querySelectorAll(".adorno-linea"),
                { scaleX: 0 },
                { scaleX: 1, duration: 0.9, ease: "power2.out" },
                0.95,
            )
            .fromTo(
                seccion.querySelector(".etiqueta"),
                { opacity: 0, y: 12 },
                { opacity: 1, y: 0, duration: 0.9, ease: "power2.out" },
                1,
            )
            // La pareja sube con un fundido, como entrando a la fiesta
            .fromTo(
                pareja,
                { opacity: 0, y: 28, filter: "blur(4px)" },
                {
                    opacity: 1,
                    y: 0,
                    filter: "blur(0px)",
                    duration: 1.3,
                    ease: "power3.out",
                },
                1.2,
            );
    });
</script>
